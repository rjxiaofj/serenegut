{
	"bsonType": "object",
	"required": ["_id", "title"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "公告ID"
		},
		"title": {
			"bsonType": "string",
			"description": "公告标题",
			"trim": "both"
		},
		"content": {
			"bsonType": "string",
			"description": "公告内容"
		},
		"is_active": {
			"bsonType": "bool",
			"description": "是否启用",
			"defaultValue": false
		},
		"sort": {
			"bsonType": "int",
			"description": "排序权重",
			"defaultValue": 0
		},
		"created_at": {
			"bsonType": "timestamp",
			"description": "创建时间"
		},
		"updated_at": {
			"bsonType": "timestamp",
			"description": "更新时间"
		}
	}
}
