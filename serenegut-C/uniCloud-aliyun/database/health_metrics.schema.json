{
	"bsonType": "object",
	"required": ["user_id", "provider", "date"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "健康数据记录ID"
		},
		"user_id": {
			"bsonType": "string",
			"description": "用户ID",
			"foreignKey": "users._id"
		},
		"provider": {
			"bsonType": "string",
			"description": "数据来源：huawei"
		},
		"date": {
			"bsonType": "string",
			"description": "日期 YYYY-MM-DD"
		},
		"heart_rate": {
			"bsonType": "double",
			"description": "最新心率"
		},
		"resting_heart_rate": {
			"bsonType": "double",
			"description": "静息心率"
		},
		"spo2": {
			"bsonType": "double",
			"description": "血氧饱和度"
		},
		"stress": {
			"bsonType": "double",
			"description": "压力指数"
		},
		"body_temperature": {
			"bsonType": "double",
			"description": "体温"
		},
		"steps": {
			"bsonType": "int",
			"description": "最近 7 天步数"
		},
		"sleep_hours": {
			"bsonType": "double",
			"description": "睡眠时长"
		},
		"synced_at": {
			"bsonType": "timestamp",
			"description": "同步时间"
		}
	}
}