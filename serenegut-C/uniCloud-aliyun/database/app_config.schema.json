{
	"bsonType": "object",
	"required": ["_id"],
	"permission": {
		"read": true,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "配置键名"
		},
		"batch_interval": {
			"bsonType": "int",
			"description": "批量同步间隔（秒），默认600秒=10分钟",
			"minimum": 30,
			"defaultValue": 600
		},
		"batch_enabled": {
			"bsonType": "bool",
			"description": "是否启用批量同步",
			"defaultValue": true
		},
		"updated_at": {
			"bsonType": "timestamp",
			"description": "最后修改时间"
		}
	}
}
