{
	"name": "client-api",
	"version": "1.0.0",
	"description": "用户端统一API云函数（module + action 双层路由）",
	"main": "index.js",
	"dependencies": {
		"bcryptjs": "^2.4.3",
		"jsonwebtoken": "^9.0.3"
	},
	"extensions": {
		"uni-cloud-jql": {}
	},
	"cloudfunction-config": {
		"memorySize": 512,
		"timeout": 60,
		"runtime": "Node.js 16",
		"triggers": [
			{
				"name": "dailyReminderTrigger",
				"type": "timer",
				"config": "0 */30 * * * * *"
			}
		]
	}
}
